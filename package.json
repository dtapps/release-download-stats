{
  "name": "release-download-stats",
  "version": "0.1.0",
  "private": false,
  "description": "Download proxy with first-party GET request statistics and badges for Cloudflare, EdgeOne, and Alibaba Cloud ESA",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy && npm run db:migrations:apply && wrangler deploy",
    "deploy:cloudflare": "npm run deploy",
    "test:esa": "vitest run tests/esa.test.js",
    "build:esa": "esbuild esa/handler.js --bundle --platform=browser --format=esm --outfile=dist/esa-handler.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.45.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.18"
  }
}
